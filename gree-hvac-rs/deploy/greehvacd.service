[Unit]
Description=Gree HVAC bridge (greehvacd)
Documentation=https://github.com/georgevgs/gree-ac
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/greehvacd

# --- configuration -----------------------------------------------------
# The AC's LAN IP, substituted from the untracked .env by deploy-pi.command.
# It is not written here because this file is committed to a public repo. Give
# the AC a static DHCP lease (FRITZ!Box: Home Network > the device > "always
# assign same address") and set AC_HOST in .env.
Environment=AC_HOST=__AC_HOST__
Environment=PORT=8481
Environment=BIND_ADDR=0.0.0.0
Environment=RUST_LOG=info
# The bridge serves the built PWA itself: one process, one URL, no web server.
Environment=PUBLIC_DIR=/srv/gree-ac/pwa
# API_TOKEN does NOT belong in this file: it is tracked in git, and
# deploy-pi.command overwrites it on every ship. Put it in a root-only drop-in,
# which survives deploys and never leaves the Pi:
#
#   sudo install -d -m 0755 /etc/systemd/system/greehvacd.service.d
#   printf '[Service]\nEnvironment=API_TOKEN=%s\n' "$(openssl rand -hex 32)" \
#     | sudo install -m 0600 /dev/stdin \
#       /etc/systemd/system/greehvacd.service.d/10-token.conf
#   sudo systemctl daemon-reload && sudo systemctl restart greehvacd
#
# The PWA then takes the same value in its Settings screen.

# --- lifecycle ---------------------------------------------------------
Restart=always
RestartSec=5
# The AC or the Wi-Fi can be down for a long time at boot; never give up.
StartLimitIntervalSec=0

# --- sandboxing --------------------------------------------------------
# The daemon writes nothing: ephemeral UDP out to port 7000, TCP 8481 in,
# and a read-only directory of static files.
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# --- Pi Zero W sizing --------------------------------------------------
# 512 MB total. The daemon idles well under 10 MB; this is a runaway guard,
# not a target. If it ever trips, something is wrong and a restart is right.
MemoryMax=96M
# Single 1 GHz ARMv6 core: keep the daemon off the scheduler's neck so ssh
# stays responsive if it ever does spin.
Nice=5

[Install]
WantedBy=multi-user.target
