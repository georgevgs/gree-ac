# Configuration for the Rust bridge (greehvacd). Copy to .env and edit.
# The daemon reads .env from the working directory or any parent, so this one
# file works whether you launch from the repo root or from gree-hvac-rs/.
# Every entry is also a CLI flag (--host, --port, …) and a plain env var.

# --- REQUIRED ---
# LAN IP of the AC unit. Set a DHCP reservation in your router so it never
# drifts. GREE binds locally over UDP; there is NO cloud key — the bridge
# derives the device key automatically on connect. You only need the IP.
#
# There is deliberately no default. A broadcast target (192.168.1.255) makes the
# daemon trust whichever device answers the scan first, and the AES key that
# answer is encrypted under is a public protocol constant, so any host on the
# LAN could answer for your AC.
AC_HOST=192.168.1.50

# --- OPTIONAL (defaults shown) ---
# GREE local UDP port. Rarely changed.
AC_PORT=7000

# HTTP port for the API and the PWA.
PORT=8481

# HTTP listen address. 0.0.0.0 = reachable from any device on the Wi-Fi.
BIND_ADDR=0.0.0.0

# Polling cadence against the AC, in ms. Changes also arrive over SSE, so this
# is mostly a liveness check.
POLL_INTERVAL_MS=3000

# CORS: comma-separated allowlist of origins allowed to call the API from
# another origin. Leave unset (the default) for no cross-origin access at all —
# the bridge serves the PWA same-origin, so none is needed. Only set this when
# the app runs from somewhere else, e.g. the Vite dev server:
# CORS_ORIGIN=http://localhost:5173
#
# `*` is refused, deliberately. With no CORS policy, a drive-by page cannot POST
# here because the required JSON content type forces a preflight that nothing
# answers; `*` would answer it and hand every website on the internet the AC.
# Name the origin instead — that is all the dev server ever needed.

# Absolute path to the built PWA (pwa/dist) so the bridge serves the app itself
# — one URL, no separate web host. Omit to run API-only.
# PUBLIC_DIR=/absolute/path/to/toyotomi-ac/pwa/dist

# Log level: error | warn | info | debug | trace. Use debug during first setup
# to watch the ECB->GCM bind handshake. (RUST_LOG overrides this if set.)
GREE_LOG_LEVEL=info

# Optional bearer token; recommended defense-in-depth whenever the bridge
# might be reachable beyond the LAN (Tailscale, a tunnel, guests on the Wi-Fi).
# When set, every /api request must send `Authorization: Bearer <token>`
# (`?token=` is accepted for the SSE stream only, which can't send headers). The
# PWA sends it from its Settings screen, stored on the phone.
# Generate one: openssl rand -hex 32
# API_TOKEN=
#
# On the Raspberry Pi the token does NOT belong here or in the systemd unit —
# both are tracked in git. It goes in a root-only drop-in on the Pi; see the
# comment in gree-hvac-rs/deploy/greehvacd.service.

# --- DEPLOYMENT (deploy-pi.command only; the daemon ignores these) ---
# Who and where the Pi is. Kept here rather than in the script because the
# script is committed: an SSH account name and an address are free
# reconnaissance. PI_HOST defaults to gree-ac.local when unset.
# PI_HOST=gree-ac.local
# PI_USER=pi
