# Configuration for the Rust bridge (greehvacd). Copy to .env and edit.
# The daemon reads .env from the working directory or any parent, so this one
# file works whether you launch from the repo root or from gree-hvac-rs/.
# Every entry is also a CLI flag (--host, --port, …) and a plain env var.

# --- REQUIRED ---
# LAN IP of the AC unit. Set a DHCP reservation in your router so it never
# drifts. GREE binds locally over UDP; there is NO cloud key — the bridge
# derives the device key automatically on connect. You only need the IP.
AC_HOST=192.168.1.50

# --- OPTIONAL (defaults shown) ---
# GREE local UDP port. Rarely changed.
AC_PORT=7000

# HTTP port for the API and the PWA.
PORT=8481

# HTTP listen address. 0.0.0.0 = reachable from any device on the Wi-Fi.
BIND_ADDR=0.0.0.0

# Polling cadence against the AC, in ms. Changes also arrive over SSE, so this
# is mostly a liveness check.
POLL_INTERVAL_MS=3000

# CORS: comma-separated allowed origins, or * for any (LAN-only trust
# assumption). Only matters if the PWA is served from somewhere else.
CORS_ORIGIN=*

# Absolute path to the built PWA (pwa/dist) so the bridge serves the app itself
# — one URL, no separate web host. Omit to run API-only.
# PUBLIC_DIR=/absolute/path/to/toyotomi-ac/pwa/dist

# Log level: error | warn | info | debug | trace. Use debug during first setup
# to watch the ECB->GCM bind handshake. (RUST_LOG overrides this if set.)
GREE_LOG_LEVEL=info

# Optional bearer token. When set, every /api request must send
# `Authorization: Bearer <token>`. Set this before exposing the daemon beyond a
# trusted LAN.
# API_TOKEN=change-me
