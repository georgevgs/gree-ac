# Empty = SAME ORIGIN: the PWA calls back to whatever host served it. This is
# the normal setup — the bridge (greehvacd) serves the built app, so API calls
# go to the same address the phone already loaded the page from. Do NOT put
# http://localhost here — on a phone "localhost" is the phone itself.
#
# Only set an explicit URL when the Vite dev server (`npm run dev`) runs
# separately from the bridge, e.g.:
#   VITE_BRIDGE_URL=http://<lan-ip-of-bridge>:8481
VITE_BRIDGE_URL=
